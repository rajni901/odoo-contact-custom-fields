<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_custom_contact_field_list" model="ir.ui.view">
        <field name="name">custom.contact.field.list</field>
        <field name="model">custom.contact.field</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="field_name"/>
                <field name="field_type"/>
                <field name="state"
                       decoration-success="state == 'created'"
                       decoration-muted="state == 'draft'"
                       widget="badge"/>
                <button name="action_create_field"
                        type="object"
                        string="Add to Contact"
                        class="btn-primary"
                        invisible="state == 'created'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_custom_contact_field_form" model="ir.ui.view">
        <field name="name">custom.contact.field.form</field>
        <field name="model">custom.contact.field</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_field"
                            type="object"
                            string="Add to Contact Form"
                            class="btn-primary"
                            invisible="state == 'created'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,created"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Field Label e.g. Nickname"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Field Configuration">
                            <field name="field_name" readonly="1"/>
                            <field name="sequence"/>
                            <field name="field_type" readonly="state == 'created'"/>
                        </group>
                        <group string="Options">
                            <field name="selection_options"
                                   invisible="field_type != 'selection'"
                                   required="field_type == 'selection'"
                                   readonly="state == 'created'"
                                   placeholder="Enter one option per line&#10;Example:&#10;Active&#10;Inactive&#10;Pending"/>
                            <field name="related_model_id"
                                   invisible="field_type != 'many2one'"
                                   required="field_type == 'many2one'"
                                   readonly="state == 'created'"/>
                        </group>
                    </group>
                    <group string="System Info" invisible="state == 'draft'">
                        <field name="field_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_custom_contact_field" model="ir.actions.act_window">
        <field name="name">Custom Contact Fields</field>
        <field name="res_model">custom.contact.field</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first custom field
            </p>
            <p>
                Add custom fields to the Contact form without any coding.
                Choose the field type, enter a label and click "Add to Contact Form".
            </p>
        </field>
    </record>

</odoo>
